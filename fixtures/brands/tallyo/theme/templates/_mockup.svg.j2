{# Minh hoạ màn bán hàng + hoá đơn in từ máy tính tiền. Là hình (role=img), không phải dữ liệu sản phẩm. #}
<svg class="mockup" viewBox="0 0 500 472" role="img" aria-labelledby="mockup-title" xmlns="http://www.w3.org/2000/svg">
  <title id="mockup-title">Minh hoạ màn hình bán hàng của {{ brand.name }} và tờ hoá đơn điện tử in từ máy tính tiền</title>
  <defs>
    <filter id="receipt-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#000000" flood-opacity="0.16"/>
    </filter>
  </defs>
  <!-- Khung trình duyệt -->
  <rect x="0.5" y="0.5" width="420" height="360" rx="14" fill="#FFFFFF" stroke="#EBEBEB"/>
  <path d="M0.5 14.5 a14 14 0 0 1 14 -14 h392 a14 14 0 0 1 14 14 v21 h-420 z" fill="#FFF0F0"/>
  <circle cx="20" cy="18" r="4.5" fill="#EBEBEB"/><circle cx="34" cy="18" r="4.5" fill="#EBEBEB"/><circle cx="48" cy="18" r="4.5" fill="#EBEBEB"/>
  <rect x="70" y="9" width="270" height="18" rx="9" fill="#FFFFFF"/>
  <text x="84" y="22" font-size="10" fill="#666666">app.tallyo.example/ban-hang</text>
  <!-- Màn bán hàng -->
  <text class="m-head" x="22" y="64" font-size="15" fill="#1A1A1A">Bán hàng · Quầy 1</text>
  <rect x="300" y="50" width="98" height="22" rx="11" fill="#E8F5F0"/>
  <text x="313" y="65" font-size="10" fill="#0F6E56">Đang có mạng</text>
  <line x1="22" y1="84" x2="398" y2="84" stroke="#EBEBEB"/>
  {% set rows = [("Nước suối 500 ml", "2 × 6.000", "12.000"), ("Mì ly", "4 × 9.000", "36.000"), ("Sữa tươi hộp 1 lít", "1 × 38.000", "38.000"), ("Bánh quy hộp", "1 × 41.000", "41.000")] %}
  {% for name, qty, amount in rows %}
  {% set y = 110 + loop.index0 * 34 %}
  <text x="22" y="{{ y }}" font-size="12.5" fill="#1A1A1A">{{ name }}</text>
  <text x="22" y="{{ y + 15 }}" font-size="10.5" fill="#666666">{{ qty }}</text>
  <text x="398" y="{{ y + 6 }}" font-size="12.5" fill="#1A1A1A" text-anchor="end">{{ amount }}</text>
  {% endfor %}
  <line x1="22" y1="252" x2="398" y2="252" stroke="#EBEBEB"/>
  <text class="m-head" x="22" y="278" font-size="13" fill="#1A1A1A">Tổng cộng</text>
  <text class="m-head" x="398" y="279" font-size="18" fill="#C00000" text-anchor="end">127.000</text>
  <rect x="22" y="298" width="182" height="40" rx="20" fill="#C00000"/>
  <text class="m-head" x="113" y="323" font-size="12.5" fill="#FFFFFF" text-anchor="middle">Thanh toán VietQR</text>
  <rect x="214" y="298" width="184" height="40" rx="20" fill="#FFFFFF" stroke="#EBEBEB"/>
  <text class="m-head" x="306" y="323" font-size="12.5" fill="#1A1A1A" text-anchor="middle">Tiền mặt</text>
  <!-- Hoá đơn in từ máy tính tiền -->
  <g filter="url(#receipt-shadow)" transform="translate(286 150) rotate(3)">
    <path d="M0 0 H200 V290 l-10 10 l-10 -10 l-10 10 l-10 -10 l-10 10 l-10 -10 l-10 10 l-10 -10 l-10 10 l-10 -10 l-10 10 l-10 -10 l-10 10 l-10 -10 l-10 10 l-10 -10 l-10 10 l-10 -10 l-10 10 l-10 -10 Z" fill="#FFFFFF"/>
    <text class="m-head" x="100" y="28" font-size="12" fill="#1A1A1A" text-anchor="middle">TẠP HOÁ MINH AN</text>
    <text x="100" y="44" font-size="8.5" fill="#666666" text-anchor="middle">Hoá đơn điện tử khởi tạo từ máy tính tiền</text>
    <line x1="14" y1="56" x2="186" y2="56" stroke="#1A1A1A" stroke-dasharray="3 3"/>
    {% for name, qty, amount in rows %}
    {% set y = 74 + loop.index0 * 16 %}
    <text x="14" y="{{ y }}" font-size="8.5" fill="#1A1A1A">{{ name }}</text>
    <text x="186" y="{{ y }}" font-size="8.5" fill="#1A1A1A" text-anchor="end">{{ amount }}</text>
    {% endfor %}
    <line x1="14" y1="138" x2="186" y2="138" stroke="#1A1A1A" stroke-dasharray="3 3"/>
    <text class="m-head" x="14" y="156" font-size="10" fill="#1A1A1A">Tổng cộng</text>
    <text class="m-head" x="186" y="156" font-size="10" fill="#1A1A1A" text-anchor="end">127.000</text>
    <text x="14" y="176" font-size="7.5" fill="#666666">Mã tra cứu (minh hoạ, không có thật):</text>
    <text x="14" y="188" font-size="7.5" fill="#1A1A1A">DEMO-TALLYO-000127</text>
    <g color="#1A1A1A">{{ qr_group(demo_qr_text, 68, 198, 64) }}</g>
    <text x="100" y="278" font-size="7.5" fill="#666666" text-anchor="middle">Quét mã để tra cứu hoá đơn</text>
  </g>
</svg>
