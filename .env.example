# Copy file này thành .env rồi điền key thật. KHÔNG commit .env.
# Thiếu key nào thì tính năng đó tự tắt và chạy bằng mock/bản dự phòng.

# --- LLM chính: DeepSeek (OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Xác nhận lại tên model theo tài liệu DeepSeek ở Phase 1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner

# --- Jina AI: embedding, rerank, reader, search ---
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual

# --- Gemini (tuỳ chọn): probe có Google Search grounding, judge độc lập ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- WordPress local (docker compose) ---
WP_BASE_URL=http://localhost:8080
WP_USERNAME=
WP_APP_PASSWORD=
# Mật khẩu database của WordPress local (docker compose), đặt chuỗi ngẫu nhiên
WP_DB_PASSWORD=
WP_DB_ROOT_PASSWORD=

# --- Bảo mật ứng dụng ---
# Sinh chuỗi ngẫu nhiên dài, ví dụ: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
APPROVAL_TOKEN_SECRET=
APPROVAL_TOKEN_TTL_MINUTES=30

# Tài khoản đăng nhập web app (Phase 1 seed từ env, không lưu trong repo).
# Để trống mật khẩu thì không tạo tài khoản đó; không có tài khoản nào thì /api/auth/login trả 503.
SEED_EDITOR_USERNAME=editor
SEED_EDITOR_PASSWORD=
SEED_APPROVER_USERNAME=approver
SEED_APPROVER_PASSWORD=

# --- Chế độ chạy ---
# true = dùng mock model và cache, không gọi API thật (dùng trong CI)
GEO_OFFLINE=false
# Nơi lưu cache LLM, trace, sqlite (mặc định backend/.data)
# GEO_DATA_DIR=
# Ghi đè bảng giá ước tính (USD / 1M token: input,output,cached_input)
# GEO_PRICE_DEEPSEEK_CHAT=0.27,1.10,0.07
